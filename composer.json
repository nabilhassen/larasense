{
    "name": "nabilhassen/larasense",
    "type": "project",
    "description": "A dedicated, Laravel-focused content aggregator.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "require": {
        "php": "^8.3",
        "blade-ui-kit/blade-heroicons": "^2.7",
        "filament/filament": "^5.6.3",
        "intervention/image-laravel": "^4.0",
        "laravel/framework": "^13.9",
        "laravel/pulse": "^1.7.3",
        "laravel/socialite": "^5.27",
        "laravel/tinker": "^3.0.2",
        "livewire/livewire": "^4.3",
        "maize-tech/laravel-markable": "^3.0",
        "opcodesio/log-viewer": "^3.24",
        "resend/resend-php": "^1.3",
        "shweshi/opengraph": "dev-laravel-13",
        "spatie/crawler": "^9.3",
        "spatie/laravel-honeypot": "^4.7.1",
        "spatie/laravel-sitemap": "^8.1.0",
        "spatie/livewire-filepond": "^1.7.1",
        "willvincent/feeds": "dev-l13-compatibility"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.2.8",
        "fakerphp/faker": "^1.24.1",
        "laravel/breeze": "^2.4.1",
        "laravel/pail": "^1.2.6",
        "laravel/pint": "^1.29.1",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.4",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laravel-shift/feeds"
        },
        {
            "type": "vcs",
            "url": "https://github.com/nabilhassen/OpenGraph"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#fdba74\" \"php artisan serve\" \"npm run dev\" --names=server,vite"
        ],
        "pest": "pest",
        "pint": "pint",
        "test:dirty": "@pest --dirty",
        "test:pint": "@pint --test",
        "test": [
            "@test:pint --parallel",
            "@pest --parallel"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
